APP_ENV=production
TELEGRAM_PAYMENT_TEST_MODE=false
BOT_TOKEN=replace_me
ADMIN_IDS=
POSTGRES_DB=steam_radar
POSTGRES_USER=steam_radar
POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql+asyncpg://steam_radar:replace_me@postgres:5432/steam_radar
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
LOG_DIR=/app/logs
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
DEAL_BROADCAST_PRICE_MAX_AGE_HOURS=26
DEAL_BROADCAST_BATCH_SIZE=50
DEAL_BROADCAST_MESSAGES_PER_SECOND=20
BACKUP_ENABLED=true
BACKUP_DIR=/app/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
